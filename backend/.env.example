# ============================================================
# BACKEND — VARIÁVEIS DE AMBIENTE
# Copie para .env e preencha ANTES de rodar o servidor
# NUNCA commite o .env no git
# ============================================================

# Supabase — pegue no painel: Settings > API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # chave service_role (NÃO a anon key)

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=GERE_UMA_CHAVE_FORTE_AQUI_64_BYTES_HEX

# CORS — origens permitidas separadas por vírgula, ou "*" para todas
# Em produção use os domínios reais: https://tattoo.exemplo.com,https://barbearia.exemplo.com
ALLOWED_ORIGINS=*

# Ambiente: development | production
FLASK_ENV=development
DEBUG=true

# Rate limiting — deixe padrão ou ajuste
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_AUTH=5 per minute
RATE_LIMIT_ADMIN_AUTH=3 per minute
RATE_LIMIT_EXPORT=2 per minute

# Supabase Storage — bucket para fotos de briefing
BRIEFINGS_BUCKET=briefings
